# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Weather — Open-Meteo (free, no API key). Used for forecast + seasonal averages.
# Optional: OpenWeatherMap is unused by default; leave blank.
OPENWEATHER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://packforvacation.com  (no trailing slash, no trailing DNS dot)
# In Supabase Auth → URL Configuration:
#   Site URL: https://packforvacation.com
#   Redirect URLs: https://packforvacation.com/**  and  com.packforvacation.app://auth/callback
# Mobile (Capacitor) also needs this API host in mobile/.env as VITE_API_URL.
# Mobile app calls POST /api/mobile/trips on this URL for AI trip generation.

# Demo mode — local dev only. MUST be false in production or login will not persist.
NEXT_PUBLIC_DEMO_MODE=true

# Mapbox (destination typeahead)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Unsplash (destination cover images — fetched once per trip, cached in Supabase)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Optional: Resend for collaborator invite emails
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=PackForVacation <invites@yourdomain.com>
