# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Weather (Open-Meteo is free, no key needed)
# Optional: OpenWeatherMap fallback
OPENWEATHER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox (destination typeahead)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token
# Or use NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN for client-side (API route prefers MAPBOX_ACCESS_TOKEN)

# Unsplash (destination cover images — fetched once per trip, cached in Supabase)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Demo mode (uses in-memory store when Supabase is not configured)
NEXT_PUBLIC_DEMO_MODE=true
