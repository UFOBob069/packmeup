# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Weather (Open-Meteo is free, no key needed)
# Optional: OpenWeatherMap fallback
OPENWEATHER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: set to your live URL, e.g. https://packforvacation.com
# Mobile (Capacitor) also needs this API host in mobile/.env as VITE_API_URL.
# Add Supabase Auth redirect: com.packforvacation.app://auth/callback
# Mobile app calls POST /api/mobile/trips on this URL for AI trip generation.

# Demo mode — local dev only. MUST be false in production or login will not persist.
NEXT_PUBLIC_DEMO_MODE=true

# Mapbox (destination typeahead)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Unsplash (destination cover images — fetched once per trip, cached in Supabase)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
