# Copy to keystore.properties (never commit the real file or .jks).
# Create a keystore once:
#   keytool -genkey -v -keystore packforvacation-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias packforvacation
#
# Then fill these values:
storeFile=packforvacation-upload.jks
storePassword=replace-me
keyAlias=packforvacation
keyPassword=replace-me
